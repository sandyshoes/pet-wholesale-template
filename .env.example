# Copy to .env; never publish .env. No default database or administrator.
APP_URL=http://localhost:8080
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_NAME=YOUR_INSTANCE_DATABASE
DB_USER=YOUR_INSTANCE_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
UPLOAD_DIR=uploads/products
UPLOAD_MAX_BYTES=5242880
BRAND_FILE=config/brand.local.json
SESSION_SECURE=0
